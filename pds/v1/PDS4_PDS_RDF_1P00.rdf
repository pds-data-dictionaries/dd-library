<kb:Designation rdf:about="kb:DES.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_interval"
	 kb:designationName="0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_interval"
	 kb:isPreferred="TRUE"
	 rdfs:label="DES.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_interval"/>
 
<kb:Definition rdf:about="&pdsns;DEF.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_interval"
	 kb:isPreferred="TRUE"
	 rdfs:label="DEF.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_interval">
	<kb:definitionText>The sampling_parameter_interval attribute provides the spacing of points at which data are sampled and at which values for an instrument or other parameter are available. If x1 and xn are the first and last sampling parameter values, respectively, xn is larger than x1, n is the number of sampling parameters, the caret symbol (^) denotes exponentiation, and b, a positive real number, is the base for exponentiation, then the value of sampling_parameter_interval is: (xn-x1)/(n-1) (for sampling_parameter_scale = Linear), (xn/x1)^(1/(n-1)) (for sampling_parameter_scale = Logarithmic), (b^xn-b^x1)/(n-1) (for sampling_parameter_scale = Exponential).</kb:definitionText>
</kb:Definition>
 
<kb:LanguageSection rdf:about="&pdsns;LS.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_interval"
	 rdfs:label="LS.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_interval">
	<kb:definition rdf:resource="&pdsns;DEF.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_interval"/>
	<kb:designation rdf:resource="&pdsns;DES.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_interval"/>
	<kb:sectionLanguage rdf:resource="&pdsns;Englsh"/>
</kb:LanguageSection>
 
