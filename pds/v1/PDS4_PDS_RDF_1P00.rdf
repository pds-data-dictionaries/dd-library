	 kb:beginDate="TBD_value_begin_date"
	 kb:endDate="TBD_value_end_date"
	 kb:value="YYYY-DOYTHH:MM:SS.SSSSSSZ"
	 rdfs:label="PV.0001_NASA_PDS_1.pds.ASCII_Date_Time_DOY_UTC.pds.formation_rule_2064925471">
	<kb:containing1 rdf:resource="&pdsns;EVD.0001_NASA_PDS_1.pds.ASCII_Date_Time_DOY_UTC.pds.formation_rule"/>
	<kb:usedIn rdf:resource="&pdsns;VM.0001_NASA_PDS_1.pds.ASCII_Date_Time_DOY_UTC.pds.formation_rule_-1395104667"/>
