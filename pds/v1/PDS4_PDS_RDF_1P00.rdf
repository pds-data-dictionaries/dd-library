<kb:Definition rdf:about="&pdsns;DEF.0001_NASA_PDS_1.pds.DD_Value_Domain.pds.unit_of_measure_type"
	 kb:isPreferred="TRUE"
	 rdfs:label="DEF.0001_NASA_PDS_1.pds.DD_Value_Domain.pds.unit_of_measure_type">
	<kb:definitionText>The unit_of_measure_type attribute identifies the class from which the attribute being defined in this data dictionary draws its possible expressions for units.</kb:definitionText>
</kb:Definition>
 
