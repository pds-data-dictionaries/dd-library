<kb:Designation rdf:about="kb:DES.0001_NASA_PDS_1.pds.Citation_Information.pds.author_list"
	 kb:designationName="0001_NASA_PDS_1.pds.Citation_Information.pds.author_list"
	 kb:isPreferred="TRUE"
	 rdfs:label="DES.0001_NASA_PDS_1.pds.Citation_Information.pds.author_list"/>
 
<kb:Definition rdf:about="&pdsns;DEF.0001_NASA_PDS_1.pds.Citation_Information.pds.author_list"
	 kb:isPreferred="TRUE"
	 rdfs:label="DEF.0001_NASA_PDS_1.pds.Citation_Information.pds.author_list">
	<kb:definitionText>The author_list attribute contains a semi-colon-separated list of names of people to be cited as authors of the associated product. The general format for individual names is: SURNAME, GIVEN NAME(s). Initials may be used in lieu of given name(s). If the name contains a suffix (&quot;Jr.&quot;, &quot;Sr.&quot;, &quot;III&quot;, etc.), the suffix is placed before the comma (,) -- e.g., Johnson Jr., Earl P.  Do not include the word &quot;and&quot; before the final author.  All authors should be listed explicitly - do not elide the list using &quot;et al&quot;.</kb:definitionText>
</kb:Definition>
 
<kb:LanguageSection rdf:about="&pdsns;LS.0001_NASA_PDS_1.pds.Citation_Information.pds.author_list"
	 rdfs:label="LS.0001_NASA_PDS_1.pds.Citation_Information.pds.author_list">
