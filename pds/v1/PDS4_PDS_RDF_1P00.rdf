<kb:Definition rdf:about="&pdsns;DEF.0001_NASA_PDS_1.pds.Special_Constants.pds.high_instrument_saturation"
	 kb:isPreferred="TRUE"
	 rdfs:label="DEF.0001_NASA_PDS_1.pds.Special_Constants.pds.high_instrument_saturation">
	<kb:definitionText>The high_instrument_saturation attribute specifies a special value whose presence indicates the measuring instrument was saturated at the high end. The value must be less than the value of the valid_minimum attribute or more than the value of the valid_maximum attribute. Values of this attribute should be represented in the same data_type as the elements in the object with which the Special_Constants class is associated.</kb:definitionText>
</kb:Definition>
 
