<kb:Designation rdf:about="kb:DES.0001_NASA_PDS_1.pds.Field_Bit.pds.start_bit_location"
	 kb:designationName="0001_NASA_PDS_1.pds.Field_Bit.pds.start_bit_location"
	 kb:isPreferred="TRUE"
	 rdfs:label="DES.0001_NASA_PDS_1.pds.Field_Bit.pds.start_bit_location"/>
 
<kb:Definition rdf:about="&pdsns;DEF.0001_NASA_PDS_1.pds.Field_Bit.pds.start_bit_location"
	 kb:isPreferred="TRUE"
	 rdfs:label="DEF.0001_NASA_PDS_1.pds.Field_Bit.pds.start_bit_location">
	<kb:definitionText>The start_bit_location attribute provides the position of the first bit in a bit field relative to the first bit in the parent packed data field. Bytes are sequential and bits are numbered continuously across byte boundaries within a single bit field. The first bit position in the packed data field is &quot;1&quot;.</kb:definitionText>
</kb:Definition>
 
