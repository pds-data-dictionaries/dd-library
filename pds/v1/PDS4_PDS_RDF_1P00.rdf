<kb:Definition rdf:about="&pdsns;DEF.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_name"
	 kb:isPreferred="TRUE"
	 rdfs:label="DEF.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_name">
	<kb:definitionText>The sampling_parameter_name element provides the name of the parameter which determines the sampling interval of a particular instrument or dataset parameter. For example, magnetic field intensity is sampled in time increments, and a spectrum is sampled in wavelength or frequency.</kb:definitionText>
</kb:Definition>
 
