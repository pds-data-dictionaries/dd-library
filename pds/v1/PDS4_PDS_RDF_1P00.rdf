	 rdfs:label="DEF.0001_NASA_PDS_1.pds.Citation_Information.pds.description">
	<kb:definitionText>The description attribute provides a short (5KB or less) description of the product as a whole.</kb:definitionText>
</kb:Definition>
 
<kb:LanguageSection rdf:about="&pdsns;LS.0001_NASA_PDS_1.pds.Citation_Information.pds.description"
