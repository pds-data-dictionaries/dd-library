	 kb:value="YYYY-MM-DDTHH:MM:SS.SSSSSSZ"
	 rdfs:label="PV.0001_NASA_PDS_1.pds.ASCII_Date_Time_YMD_UTC.pds.formation_rule_-883911904">
	<kb:containing1 rdf:resource="&pdsns;EVD.0001_NASA_PDS_1.pds.ASCII_Date_Time_YMD_UTC.pds.formation_rule"/>
