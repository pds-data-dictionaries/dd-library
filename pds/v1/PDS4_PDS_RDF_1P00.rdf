<kb:Designation rdf:about="kb:DES.0001_NASA_PDS_1.pds.Target_PDS3.pds.rotation_direction"
	 kb:designationName="0001_NASA_PDS_1.pds.Target_PDS3.pds.rotation_direction"
	 kb:isPreferred="TRUE"
	 rdfs:label="DES.0001_NASA_PDS_1.pds.Target_PDS3.pds.rotation_direction"/>
 
<kb:Definition rdf:about="&pdsns;DEF.0001_NASA_PDS_1.pds.Target_PDS3.pds.rotation_direction"
	 kb:isPreferred="TRUE"
	 rdfs:label="DEF.0001_NASA_PDS_1.pds.Target_PDS3.pds.rotation_direction">
	<kb:definitionText>The rotation_direction element provides the direction of rotation as viewed from the north pole of the &apos;invariable plane of the solar system&apos;, which is the plane passing through the center of mass of the solar system and perpendicular to the angular momentum vector of the solar system. The value for this element is PROGRADE for counter -clockwise rotation, RETROGRADE for clockwise rotation and SYNCHRONOUS for satellites which are tidally locked with the primary. Sidereal_rotation_period and rotation_direction_type are unknown for a number of satellites, and are not applicable (N/A) for satellites which are tumbling.</kb:definitionText>
</kb:Definition>
 
<kb:LanguageSection rdf:about="&pdsns;LS.0001_NASA_PDS_1.pds.Target_PDS3.pds.rotation_direction"
	 rdfs:label="LS.0001_NASA_PDS_1.pds.Target_PDS3.pds.rotation_direction">
	<kb:definition rdf:resource="&pdsns;DEF.0001_NASA_PDS_1.pds.Target_PDS3.pds.rotation_direction"/>
	<kb:designation rdf:resource="&pdsns;DES.0001_NASA_PDS_1.pds.Target_PDS3.pds.rotation_direction"/>
	<kb:sectionLanguage rdf:resource="&pdsns;Englsh"/>
</kb:LanguageSection>
 
