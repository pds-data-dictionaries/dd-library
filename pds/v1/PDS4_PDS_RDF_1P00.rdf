<kb:Definition rdf:about="&pdsns;DEF.0001_NASA_PDS_1.pds.Volume_Set_PDS3.pds.volume_set_name"
	 kb:isPreferred="TRUE"
	 rdfs:label="DEF.0001_NASA_PDS_1.pds.Volume_Set_PDS3.pds.volume_set_name">
	<kb:definitionText>The volume_set_name element provides the full, formal name of one or more data volumes containing a single data set or a collection of related data sets. Volume sets are normally considered as a single orderable entity.</kb:definitionText>
</kb:Definition>
 
