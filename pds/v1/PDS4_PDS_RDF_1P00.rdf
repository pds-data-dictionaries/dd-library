<kb:Definition rdf:about="&pdsns;DEF.0001_NASA_PDS_1.pds.Band_Bin.pds.filter_number"
	 kb:isPreferred="TRUE"
	 rdfs:label="DEF.0001_NASA_PDS_1.pds.Band_Bin.pds.filter_number">
	<kb:definitionText>The filter_number attribute of a spectral qube describes the physical location of a band (identified by the band_number) in a detector array. Filter 1 is on the leading edge of the array.</kb:definitionText>
</kb:Definition>
 
