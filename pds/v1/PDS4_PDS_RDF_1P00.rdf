	 kb:endDate="TBD_value_end_date"
	 kb:value="YYYY-MM-DDTHH:MM:SS.SSSSSS(Z)"
	 rdfs:label="PV.0001_NASA_PDS_1.pds.ASCII_Date_Time_YMD.pds.formation_rule_964139645">
	<kb:containing1 rdf:resource="&pdsns;EVD.0001_NASA_PDS_1.pds.ASCII_Date_Time_YMD.pds.formation_rule"/>
