<kb:Definition rdf:about="&pdsns;DEF.0001_NASA_PDS_1.pds.Object_Statistics.pds.bit_mask"
	 kb:isPreferred="TRUE"
	 rdfs:label="DEF.0001_NASA_PDS_1.pds.Object_Statistics.pds.bit_mask">
	<kb:definitionText>The bit mask attribute is a series of ASCII binary digits identifying the active bits in a value; it has exactly the same number of bits as the array element to which it is applied. The bit mask must be specified from most significant to least significant bit (left to right).</kb:definitionText>
</kb:Definition>
 
