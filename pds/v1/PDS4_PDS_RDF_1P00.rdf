<kb:Definition rdf:about="&pdsns;DEF.0001_NASA_PDS_1.pds.Tracking_Detail.pds.certified_flag"
	 kb:isPreferred="TRUE"
	 rdfs:label="DEF.0001_NASA_PDS_1.pds.Tracking_Detail.pds.certified_flag">
	<kb:definitionText>The certified flag attribute indicates that the data is sufficiently complete, formatted, and documented for use by scientists who are not directly affiliated with the providers. An archive_status of &quot;In Peer Review&quot; indicates that the data product or release is not yet certified by the PDS.</kb:definitionText>
</kb:Definition>
 
