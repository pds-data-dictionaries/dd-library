	 kb:beginDate="TBD_value_begin_date"
	 kb:endDate="TBD_value_end_date"
	 kb:value="YYYY-DOYTHH:MM:SS.SSSSSS(Z)"
	 rdfs:label="PV.0001_NASA_PDS_1.pds.ASCII_Date_Time_DOY.pds.formation_rule_118441660">
	<kb:containing1 rdf:resource="&pdsns;EVD.0001_NASA_PDS_1.pds.ASCII_Date_Time_DOY.pds.formation_rule"/>
