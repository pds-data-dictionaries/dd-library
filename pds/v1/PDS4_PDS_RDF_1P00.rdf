	 kb:value="YYYY-MM-DDTHH:MM:SS.SSSZ/YYYY-DOYTHH:MM:SS.SSSZ"
	 rdfs:label="PV.0001_NASA_PDS_1.pds.ASCII_Date_Time_UTC.pds.formation_rule_1084188208">
	<kb:containing1 rdf:resource="&pdsns;EVD.0001_NASA_PDS_1.pds.ASCII_Date_Time_UTC.pds.formation_rule"/>
