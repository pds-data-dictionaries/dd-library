	 rdfs:label="LS.0001_NASA_PDS_1.pds.Field_Binary.pds.scaling_factor">
	<kb:definition rdf:resource="&pdsns;DEF.0001_NASA_PDS_1.pds.Field_Binary.pds.scaling_factor"/>
	<kb:designation rdf:resource="&pdsns;DES.0001_NASA_PDS_1.pds.Field_Binary.pds.scaling_factor"/>
	<kb:sectionLanguage rdf:resource="&pdsns;Englsh"/>
