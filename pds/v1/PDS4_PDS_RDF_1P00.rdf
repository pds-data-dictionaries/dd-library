<kb:Designation rdf:about="kb:DES.0001_NASA_PDS_1.pds.Band_Bin.pds.scaling_factor"
	 kb:designationName="0001_NASA_PDS_1.pds.Band_Bin.pds.scaling_factor"
	 kb:isPreferred="TRUE"
	 rdfs:label="DES.0001_NASA_PDS_1.pds.Band_Bin.pds.scaling_factor"/>
 
<kb:Definition rdf:about="&pdsns;DEF.0001_NASA_PDS_1.pds.Band_Bin.pds.scaling_factor"
	 kb:isPreferred="TRUE"
	 rdfs:label="DEF.0001_NASA_PDS_1.pds.Band_Bin.pds.scaling_factor">
	<kb:definitionText>The scaling_factor attribute is the scaling factor to be applied to each stored value in order to recover an original  value. The observed value (Ov) is calculated from the stored value (Sv) thus: Ov = (Sv * scaling_factor) + value_offset. The default value is 1.</kb:definitionText>
</kb:Definition>
 
