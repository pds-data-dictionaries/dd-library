  <kb:administrationRecord rdf:resource="&pdsns;DD_1.25.0.0"/>
  <kb:registrationAuthorityIdentifier rdf:resource="&pdsns;0001_NASA_PDS_1"/>
</kb:EnumeratedValueDomain>
 
<kb:PermissibleValue rdf:about="&pdsns;PV.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_1622534582"
	 kb:beginDate="TBD_value_begin_date"
	 kb:endDate="TBD_value_end_date"
	 kb:value="Field Campaign"
	 rdfs:label="PV.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_1622534582">
	<kb:containing1 rdf:resource="&pdsns;EVD.0001_NASA_PDS_1.pds.Investigation_Area.pds.type"/>
	<kb:usedIn rdf:resource="&pdsns;VM.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_-1808399246"/>
</kb:PermissibleValue>
 
<kb:ValueMeaning rdf:about="&pdsns;VM.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_-1808399246"
	 kb:beginDate="TBD_value_begin_date"
	 kb:description="A set of experiments and/or observations with a clearly defined purpose that is coordinated among one or more individuals and/or one or more organizations. The campaign is characterized primarily by its in situ terrestrial field work."
	 kb:endDate="TBD_value_end_date"
	 rdfs:label="VM.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_-1808399246"/>
 
<kb:PermissibleValue rdf:about="&pdsns;PV.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_1073663419"
	 kb:beginDate="TBD_value_begin_date"
	 kb:endDate="TBD_value_end_date"
	 kb:value="Individual Investigation"
	 rdfs:label="PV.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_1073663419">
	<kb:containing1 rdf:resource="&pdsns;EVD.0001_NASA_PDS_1.pds.Investigation_Area.pds.type"/>
	<kb:usedIn rdf:resource="&pdsns;VM.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_-316210160"/>
</kb:PermissibleValue>
 
<kb:ValueMeaning rdf:about="&pdsns;VM.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_-316210160"
	 kb:beginDate="TBD_value_begin_date"
	 kb:description="A set of experiments and/or observations with a clearly defined purpose that uses existing facilities and is under the direction of a single individual. For example, a series of related laboratory experiments/observations conducted by a small university team and funded through a single proposal could be an Individual Investigation. Library research by one person on previously published results to distill common conclusions could also be an Individual Investigation."
	 kb:endDate="TBD_value_end_date"
	 rdfs:label="VM.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_-316210160"/>
 
<kb:PermissibleValue rdf:about="&pdsns;PV.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_-1560864404"
	 kb:beginDate="TBD_value_begin_date"
	 kb:endDate="TBD_value_end_date"
	 kb:value="Mission"
	 rdfs:label="PV.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_-1560864404">
	<kb:containing1 rdf:resource="&pdsns;EVD.0001_NASA_PDS_1.pds.Investigation_Area.pds.type"/>
	<kb:usedIn rdf:resource="&pdsns;VM.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_301045246"/>
</kb:PermissibleValue>
 
<kb:ValueMeaning rdf:about="&pdsns;VM.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_301045246"
	 kb:beginDate="TBD_value_begin_date"
	 kb:description="A set of experiments and/or observations with a clearly defined purpose that occupies the designated resources for all (or at least a significant fraction) of the available time. A mission is usually conducted by a national or international space agency using a small number (often one) of spacecraft especially designed and built for the purpose. For example: (1) the NASA Voyager mission launched two spacecraft to Jupiter and Saturn; (2) the Deep Impact (DI) mission launched a spacecraft, part of which impacted the comet Tempel 2; and (3) the EPOXI mission redefined the objectives of the surviving DI hardware for further exploration of the solar system."
	 kb:endDate="TBD_value_end_date"
	 rdfs:label="VM.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_301045246"/>
 
<kb:PermissibleValue rdf:about="&pdsns;PV.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_-955543881"
	 kb:beginDate="TBD_value_begin_date"
	 kb:endDate="TBD_value_end_date"
	 kb:value="Observing Campaign"
	 rdfs:label="PV.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_-955543881">
	<kb:containing1 rdf:resource="&pdsns;EVD.0001_NASA_PDS_1.pds.Investigation_Area.pds.type"/>
	<kb:usedIn rdf:resource="&pdsns;VM.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_638852493"/>
</kb:PermissibleValue>
 
<kb:ValueMeaning rdf:about="&pdsns;VM.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_638852493"
	 kb:beginDate="TBD_value_begin_date"
	 kb:description="A set of experiments and/or observations with a clearly defined purpose that uses (primarily) existing facilities, but not exclusively. After (and possibly during) the campaign other investigations are carried out using the same facilities. For example, the International Halley Watch mobilized observatories around the world for collection of data during the most recent apparition of Comet Halley. The Shoemaker-Levy-9 (SL9) campaign used both Earth-based and spacecraft instruments to monitor the SL9 impact on Jupiter."
	 kb:endDate="TBD_value_end_date"
	 rdfs:label="VM.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_638852493"/>
 
<kb:PermissibleValue rdf:about="&pdsns;PV.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_-179916366"
	 kb:beginDate="TBD_value_begin_date"
	 kb:endDate="TBD_value_end_date"
	 kb:value="Other Investigation"
	 rdfs:label="PV.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_-179916366">
	<kb:containing1 rdf:resource="&pdsns;EVD.0001_NASA_PDS_1.pds.Investigation_Area.pds.type"/>
	<kb:usedIn rdf:resource="&pdsns;VM.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_1375688178"/>
</kb:PermissibleValue>
 
<kb:ValueMeaning rdf:about="&pdsns;VM.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_1375688178"
	 kb:beginDate="TBD_value_begin_date"
	 kb:description="Any other set of experiments and/or observations with a unifying theme."
	 kb:endDate="TBD_value_end_date"
	 rdfs:label="VM.0001_NASA_PDS_1.pds.Investigation_Area.pds.type_1375688178"/>
 
