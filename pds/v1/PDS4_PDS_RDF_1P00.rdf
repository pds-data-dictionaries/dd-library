<kb:Definition rdf:about="&pdsns;DEF.0001_NASA_PDS_1.pds.DD_Attribute_Full.pds.attribute_concept"
	 kb:isPreferred="TRUE"
	 rdfs:label="DEF.0001_NASA_PDS_1.pds.DD_Attribute_Full.pds.attribute_concept">
	<kb:definitionText>The attribute_concept attribute provides the type of information (classification) conveyed by the attribute -- e.g., stop_date_time has  attribute_concept = date_time.</kb:definitionText>
</kb:Definition>
 
