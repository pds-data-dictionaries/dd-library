<kb:PermissibleValue rdf:about="&pdsns;PV.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale_-97545947"
	 kb:beginDate="TBD_value_begin_date"
	 kb:endDate="TBD_value_end_date"
	 kb:value="Exponential"
	 rdfs:label="PV.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale_-97545947">
	<kb:containing1 rdf:resource="&pdsns;EVD.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale"/>
	<kb:usedIn rdf:resource="&pdsns;VM.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale_-241623528"/>
</kb:PermissibleValue>
 
<kb:ValueMeaning rdf:about="&pdsns;VM.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale_-241623528"
	 kb:beginDate="TBD_value_begin_date"
	 kb:description="The values of the independent variable in Exponential Uniformly Sampled data are given at uniform spacing of the exponential of some base b, a positive real number.  That is, for independent variable x in the range [x1, xn], the sampling points xj satisfy: b^xj = b^x1 + (j-1)(b^xn - b^x1)/(n-1) for j = 1 ... n where the caret symbol (^) denotes exponentiation. For example, if the independent variable has values  0., 0.30103, 0.47712, 0.60206, ... and the base is 10, then the Exponential Uniformly Spaced data are given at 10^0., 10^0.30103, 10^0.47712, 10^0.60206, ... or 1, 2, 3, 4, ..."
	 kb:endDate="TBD_value_end_date"
	 rdfs:label="VM.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale_-241623528"/>
 
<kb:PermissibleValue rdf:about="&pdsns;PV.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale_-2018804923"
	 kb:beginDate="TBD_value_begin_date"
	 kb:endDate="TBD_value_end_date"
	 kb:value="Linear"
	 rdfs:label="PV.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale_-2018804923">
	<kb:containing1 rdf:resource="&pdsns;EVD.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale"/>
	<kb:usedIn rdf:resource="&pdsns;VM.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale_-103272635"/>
</kb:PermissibleValue>
 
<kb:ValueMeaning rdf:about="&pdsns;VM.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale_-103272635"
	 kb:beginDate="TBD_value_begin_date"
	 kb:description="Values of Uniformly_Sampled are given at uniform (linear) spacings of an independent variable - for example, 1, 2, 3, 4, ..."
	 kb:endDate="TBD_value_end_date"
	 rdfs:label="VM.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale_-103272635"/>
 
<kb:PermissibleValue rdf:about="&pdsns;PV.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale_1809749791"
	 kb:beginDate="TBD_value_begin_date"
	 kb:endDate="TBD_value_end_date"
	 kb:value="Logarithmic"
	 rdfs:label="PV.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale_1809749791">
	<kb:containing1 rdf:resource="&pdsns;EVD.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale"/>
	<kb:usedIn rdf:resource="&pdsns;VM.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale_-697930768"/>
</kb:PermissibleValue>
 
<kb:ValueMeaning rdf:about="&pdsns;VM.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale_-697930768"
	 kb:beginDate="TBD_value_begin_date"
	 kb:description="The values of the independent variable, x, in Logarithmic Uniformly Sampled data are given at uniform spacing of the logarithm of x in some base, b, a positive real number.  That is, for independent variable x in the range [x1, xn], the sampling points xj satisfy: log_b(xj) = log_b(x1) + (j-1)(log_b(xn) - log_b(x1))/(n-1) for j = 1 ... n where log_b(x) is the log of x in base b. For example, if the independent variable has values 1, 10, 100, 1000, ... and the base is 10, then the Logarithmic Uniformly Spaced data are given at 0, 1, 2, 3 ..."
	 kb:endDate="TBD_value_end_date"
	 rdfs:label="VM.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.sampling_parameter_scale_-697930768"/>
 
