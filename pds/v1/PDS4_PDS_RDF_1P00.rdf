<kb:ValueMeaning rdf:about="&pdsns;VM.0001_NASA_PDS_1.pds.ASCII_Date_Time_DOY_UTC.pds.formation_rule_-1395104667"
	 kb:beginDate="TBD_value_begin_date"
	 kb:description="YYYY-DOYTHH:MM:SS.SSSSSSZ - The date must be expressed in the YYYY-DOY format where YYYY is the 4-digit year (-9999 to 9999) and DOY is the 3-digit day-of-year (001-366). &quot;T&quot; is a delimiter separating date and time. Time must be expressed in the HH:MM:SS.SSSSSSZ format where HH is the 2-digit hour (00-23), MM is the 2-digit minute (00-59), SS is the 2-digit integer second (00-60), SSSSSS is microseconds (000000-999999), and &quot;Z&quot; denotes UTC."
	 kb:endDate="TBD_value_end_date"
	 rdfs:label="VM.0001_NASA_PDS_1.pds.ASCII_Date_Time_DOY_UTC.pds.formation_rule_-1395104667"/>
 
