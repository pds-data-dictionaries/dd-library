	 kb:beginDate="TBD_value_begin_date"
	 kb:description="Product_Zipped is in container type TAR, a file format that aggregates many small files, their ownership and status information, and their relative organization into a single larger file.  See http://www.freebsd.org/cgi/man.cgi?query=tar&amp;sektion=5&amp;manpath=FreeBSD+8-current"
	 kb:endDate="TBD_value_end_date"
	 rdfs:label="VM.0001_NASA_PDS_1.pds.Zip.pds.container_type_1819419362"/>
 
