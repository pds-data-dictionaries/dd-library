<kb:ValueMeaning rdf:about="&pdsns;VM.0001_NASA_PDS_1.pds.Units_of_Power.pds.unit_id_1432878537"
	 kb:beginDate="TBD_value_begin_date"
	 kb:description="dBm is an abbreviation for decibels relative to one milliwatt, which is a unit of power that is on a logarithmic scale. If x is the power in milliwatts (mW), then the power in dBm is given by 10*log10(x). To give two examples, 0 dBm corresponds to 1 mW, and 30 dBm corresponds to 1 W."
	 kb:endDate="TBD_value_end_date"
	 rdfs:label="VM.0001_NASA_PDS_1.pds.Units_of_Power.pds.unit_id_1432878537"/>
 
